# Supabase (server-side, service role — KEEP SECRET)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Blockchain RPC
RPC_URL=http://127.0.0.1:8545

# Contract addresses
MANAGER_ADDRESS=0x...

# Indexer wallet (used for auto-finalize txs — KEEP SECRET)
PRIVATE_KEY=0x...
